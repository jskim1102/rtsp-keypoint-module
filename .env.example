# 포트 offset (RULES §4: 파생포트 = 시작포트 + (PORT_OFFSET − 1))
PORT_OFFSET=
BACKEND_PORT=
FRONTEND_PORT=

# mediamtx → 이 모듈 compose 의 bundled 인스턴스. 포트 = base + PORT_OFFSET
MEDIAMTX_API=http://mediamtx:9997
# mediamtx API (예: 9997 + offset)
MEDIAMTX_API_PORT=
# mediamtx RTSP (예: 8554 + offset)
MEDIAMTX_RTSP_PORT=
# mediamtx WebRTC/WHEP (예: 8889 + offset)
MEDIAMTX_WEBRTC_PORT=
# mediamtx ICE UDP (예: 8189 + offset)
MEDIAMTX_ICE_UDP_PORT=
MEDIAMTX_WEBRTC_HOST=
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_keypoint
MEDIAMTX_VIEWER_PASS=

# keypoint (YOLO pose 추론). YOLO_DEVICE 빈값 = GPU 자동감지, 없으면 CPU 폴백.
YOLO_DEFAULT_MODEL=yolo26n-pose.pt
YOLO_CONF_THRESHOLD=0.5
YOLO_DEVICE=
